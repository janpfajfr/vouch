{
  "name": "vouch",
  "version": "0.1.0",
  "description": "A dependency-governance gate that records who vouched for each dependency — for Node.js projects and coding agents.",
  "type": "module",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "vouch": "dist/src/cli.js"
  },
  "files": [
    "dist/src",
    "assets",
    "schema.json"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc",
    "test": "tsc && node --test 'dist/test/**/*.js'",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.5.0"
  },
  "license": "MIT"
}
